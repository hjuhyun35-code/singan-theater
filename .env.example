# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤, 따옴표 없이 값만 채우세요.
# .env 파일은 비밀번호와 같습니다. 남에게 보여주거나 인터넷에 올리면 안 됩니다.

# --- 1단계: 이것만 있으면 초안을 만들어 볼 수 있습니다 ---

# 알라딘 Open API 키 — https://www.aladin.co.kr/ttb/wblog_manage.aspx
ALADIN_TTB_KEY=

# Anthropic API 키 — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# 국립중앙도서관 서지정보 인증키 (목차·책소개 보강. 없어도 동작합니다)
# https://www.nl.go.kr/NL/contents/N31101010000.do
NL_API_KEY=

# --- 2단계: 실제로 올리려면 필요합니다 ---

# 이미지 호스팅 — https://api.imgbb.com/
# (쓰레드/인스타는 '공개된 이미지 주소'만 받기 때문에 필요합니다)
IMGBB_API_KEY=

# 쓰레드 (Meta 앱 - Threads 용도)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# 인스타그램 (Meta 앱 - Instagram 용도. 쓰레드와는 다른 앱입니다)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
